  // Initialize AudioContext after user interaction
  const initAudio = () => {
    if (!audioContextRef.current) {
      audioContextRef.current = new (window.AudioContext || window.webkitAudioContext)()
    }
  }

  // Play a short rising tone for game start
  const playStartSound = () => {
    initAudio()
    const ctx = audioContextRef.current
    const osc = ctx.createOscillator()
    const gain = ctx.createGain()

    osc.connect(gain)
    gain.connect(ctx.destination)

    osc.frequency.setValueAtTime(400, ctx.currentTime)
    osc.frequency.exponentialRampToValueAtTime(800, ctx.currentTime + 0.3)
    
    gain.gain.setValueAtTime(0.15, ctx.currentTime)
    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3)

    osc.start(ctx.currentTime)
    osc.stop(ctx.currentTime + 0.3)
  }

  // Start background music - looping melody like retro games
  const startBackgroundSound = () => {
    initAudio()
    const ctx = audioContextRef.current

    // Stop existing background sound if any
    stopBackgroundSound()

    // Create a simple melodic pattern that loops
    const playMelodyLoop = () => {
      const melody = [
        { freq: 262, duration: 0.3 }, // C4
        { freq: 330, duration: 0.3 }, // E4
        { freq: 392, duration: 0.3 }, // G4
        { freq: 330, duration: 0.3 }, // E4
        { freq: 294, duration: 0.3 }, // D4
        { freq: 330, duration: 0.3 }, // E4
        { freq: 262, duration: 0.3 }, // C4
        { freq: 247, duration: 0.3 }, // B3
      ]

      let time = ctx.currentTime
      melody.forEach((note) => {
        const osc = ctx.createOscillator()
        const gain = ctx.createGain()

        osc.type = 'square'
        osc.frequency.setValueAtTime(note.freq, time)
        
        gain.gain.setValueAtTime(0, time)
        gain.gain.linearRampToValueAtTime(0.04, time + 0.01)
        gain.gain.linearRampToValueAtTime(0.02, time + note.duration * 0.7)
        gain.gain.linearRampToValueAtTime(0, time + note.duration)

        osc.connect(gain)
        gain.connect(ctx.destination)

        osc.start(time)
        osc.stop(time + note.duration)

        time += note.duration
      })
    }

    // Play the melody loop immediately and then repeat every 2.4 seconds
    playMelodyLoop()
    bgmIntervalRef.current = setInterval(playMelodyLoop, 2400)
  }

  // Stop background sound
  const stopBackgroundSound = () => {
    if (bgmIntervalRef.current) {
      clearInterval(bgmIntervalRef.current)
      bgmIntervalRef.current = null
    }
    if (backgroundOscillatorRef.current) {
      try {
        backgroundOscillatorRef.current.stop()
      } catch (e) {
        // Already stopped
      }
      backgroundOscillatorRef.current = null
      backgroundGainRef.current = null
    }
  }

  // Play short click/step sound for movement (50-100ms)
  const playMoveSound = () => {
    if (!audioContextRef.current) return
    const ctx = audioContextRef.current
    const osc = ctx.createOscillator()
    const gain = ctx.createGain()

    osc.type = 'square'
    osc.frequency.setValueAtTime(200, ctx.currentTime)
    
    gain.gain.setValueAtTime(0.05, ctx.currentTime)
    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.05)

    osc.connect(gain)
    gain.connect(ctx.destination)

    osc.start(ctx.currentTime)
    osc.stop(ctx.currentTime + 0.05)
  }

  // Play ascending notes for win
  const playWinSound = () => {
    if (!audioContextRef.current) return
    const ctx = audioContextRef.current
    
    const notes = [523, 659, 784, 1047] // C5, E5, G5, C6
    notes.forEach((freq, index) => {
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()

      osc.frequency.setValueAtTime(freq, ctx.currentTime)
      gain.gain.setValueAtTime(0.1, ctx.currentTime + index * 0.15)
      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + index * 0.15 + 0.2)

      osc.connect(gain)
      gain.connect(ctx.destination)

      osc.start(ctx.currentTime + index * 0.15)
      osc.stop(ctx.currentTime + index * 0.15 + 0.2)
    })
  }

  // Play descending/low tone for lose
  const playLoseSound = () => {
    if (!audioContextRef.current) return
    const ctx = audioContextRef.current
    
    const osc = ctx.createOscillator()
    const gain = ctx.createGain()

    osc.frequency.setValueAtTime(400, ctx.currentTime)
    osc.frequency.exponentialRampToValueAtTime(100, ctx.currentTime + 0.5)
    
    gain.gain.setValueAtTime(0.15, ctx.currentTime)
    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.5)

    osc.connect(gain)
    gain.connect(ctx.destination)

    osc.start(ctx.currentTime)
    osc.stop(ctx.currentTime + 0.5)
  }

  // Play warning beep (short high-pitched tone)
  const playWarningBeep = () => {
    if (!audioContextRef.current) return
    const ctx = audioContextRef.current
    
    const osc = ctx.createOscillator()
    const gain = ctx.createGain()

    osc.type = 'sine'
    osc.frequency.setValueAtTime(880, ctx.currentTime) // A5 note
    
    gain.gain.setValueAtTime(0.08, ctx.currentTime)
    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.1)

    osc.connect(gain)
    gain.connect(ctx.destination)

    osc.start(ctx.currentTime)
    osc.stop(ctx.currentTime + 0.1)
  }

  // Play positive investment sound (advantage checkpoint)
  const playGoodInvestSound = () => {
    if (!audioContextRef.current) return
    const ctx = audioContextRef.current
    
    // Two ascending notes for positive feedback
    const notes = [523, 659] // C5, E5
    notes.forEach((freq, index) => {
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()

      osc.frequency.setValueAtTime(freq, ctx.currentTime)
      gain.gain.setValueAtTime(0.12, ctx.currentTime + index * 0.1)
      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + index * 0.1 + 0.15)

      osc.connect(gain)
      gain.connect(ctx.destination)

      osc.start(ctx.currentTime + index * 0.1)
      osc.stop(ctx.currentTime + index * 0.1 + 0.15)
    })
  }

  // Play negative investment sound (disadvantage checkpoint)
  const playBadInvestSound = () => {
    if (!audioContextRef.current) return
    const ctx = audioContextRef.current
    
    // Two descending notes for negative feedback
    const notes = [392, 294] // G4, D4
    notes.forEach((freq, index) => {
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()

      osc.type = 'triangle'
      osc.frequency.setValueAtTime(freq, ctx.currentTime)
      gain.gain.setValueAtTime(0.12, ctx.currentTime + index * 0.1)
      gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + index * 0.1 + 0.15)

      osc.connect(gain)
      gain.connect(ctx.destination)

      osc.start(ctx.currentTime + index * 0.1)
      osc.stop(ctx.currentTime + index * 0.1 + 0.15)
    })
  }

  // Play neutral investment sound (mixed/neutral checkpoint)
  const playNeutralInvestSound = () => {
    if (!audioContextRef.current) return
    const ctx = audioContextRef.current
    
    // Single sustained note for neutral feedback
    const osc = ctx.createOscillator()
    const gain = ctx.createGain()

    osc.type = 'sine'
    osc.frequency.setValueAtTime(440, ctx.currentTime) // A4 note
    
    gain.gain.setValueAtTime(0.1, ctx.currentTime)
    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.2)

    osc.connect(gain)
    gain.connect(ctx.destination)

    osc.start(ctx.currentTime)
    osc.stop(ctx.currentTime + 0.2)
  }

  // Play skip sound (short blip)
  const playSkipSound = () => {
    if (!audioContextRef.current) return
    const ctx = audioContextRef.current
    
    const osc = ctx.createOscillator()
    const gain = ctx.createGain()

    osc.type = 'square'
    osc.frequency.setValueAtTime(330, ctx.currentTime) // E4 note
    
    gain.gain.setValueAtTime(0.08, ctx.currentTime)
    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.08)

    osc.connect(gain)
    gain.connect(ctx.destination)

    osc.start(ctx.currentTime)
    osc.stop(ctx.currentTime + 0.08)
  }

  return {
    playStartSound,
    startBackgroundSound,
    stopBackgroundSound,
    playMoveSound,
    playWinSound,
    playLoseSound,
    playWarningBeep,
    playGoodInvestSound,
    playBadInvestSound,
    playNeutralInvestSound,
    playSkipSound,
  }
}

// 30x30 grid with challenging maze layout and 15 checkpoints
const MAP_WIDTH = 30
const MAP_HEIGHT = 37

// Math Wall barrier cells - creates continuous walls dividing the grid into quadrants
// Horizontal barrier at row 18 (middle of 0-36)
// Vertical barrier at column 15 (middle of 0-29)
const MATH_WALL_CELLS = new Set()

// Populate Math Wall cells for horizontal barrier (row 18)
for (let x = 0; x < MAP_WIDTH; x++) {
  MATH_WALL_CELLS.add(`${x},18`)
}

// Populate Math Wall cells for vertical barrier (column 15)
for (let y = 0; y < MAP_HEIGHT; y++) {
  MATH_WALL_CELLS.add(`15,${y}`)
}

// Math Wall "gates" - positions where player can solve the puzzle to unlock passage
// 16 gates total (14 unique questions + 2 repeats)
const MATH_WALL_GATES = [
  // Horizontal barrier gates (row 18) - 8 gates
