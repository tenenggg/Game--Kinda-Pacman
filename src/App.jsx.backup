  ['W', 'F', 'W', 'W', 'W', 'F', 'W', 'W', 'W', 'F', 'W', 'W', 'F', 'F', 'F', 'W', 'W', 'W', 'F', 'W', 'W', 'W', 'F', 'W', 'W', 'F', 'W', 'W', 'F', 'W'],
