  },
  Y2: {
    id: 'Y2',
    type: 'neutral',
    name: '⚡ Quick Fix',
    description: 'Fast temporary solution to safety issues.',
    cost: 1000,
    safetyChange: +2,
    accidentRiskChange: +6,
    budgetChange: 0,
    timeChange: +2,
  },
  Y3: {
    id: 'Y3',
